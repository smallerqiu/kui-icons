{
  "name": "kui-icons",
  "version": "4.3.2",
  "description": "Ionicons for KUI",
  "main": "dist/kui-icons.cjs.js",
  "module": "dist/kui-icons.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/kui-icons.umd.js",
  "jsdelivr": "dist/kui-icons.umd.js",
  "files": [
    "source",
    "dist",
    "utils"
  ],
  "scripts": {
    "build": "npm run build:base && npm run build:types && npm run build:next",
    "build:base": "tsx index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:next": "rollup -c rollup.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "Qiu",
  "license": "MIT",
  "keywords": [
    "kui icons",
    "svg icons"
  ],
  "homepage": "https://github.com/smallerqiu/kui-icons.git",
  "bugs": {
    "url": "https://github.com/smallerqiu/kui-icons/issues",
    "email": "smallerqiu@gmail.com"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.5.0",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.4.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@types/jsdom": "^28.0.1",
    "fast-glob": "^3.3.3",
    "jsdom": "^29.0.1",
    "svg-pathdata": "^9.0.0",
    "tslib": "^2.8.1"
  },
  "type": "module"
}
